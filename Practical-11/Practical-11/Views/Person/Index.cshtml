@model List<Practical_11.Models.Person>
@{
    ViewBag.Title = "Index";
}
<hr />
<div class="container">

    <div class="mb-2">
        @Html.ActionLink("Create", "Create", null, new { @class = "btn btn-primary" })
    </div>

    <h3>List of Person</h3>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Date Of Birth</th>
                <th>Address</th>
                <th>Action</th>
            </tr>
            </thead>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="5" style="color:red;">Not Found</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@(item.DOB.HasValue ? item.DOB.Value.ToString("dd-MM-yyyy") : "")</td>
                        <td>@item.Address</td>
                        <td>
                            @Html.ActionLink("Update", "Update", new { id = @item.Id }, new { @class = "btn btn-info" })
                            @Html.ActionLink("Delete", "Delete", new { id = @item.Id }, new { @class = "btn btn-danger" })
                        </td>
                    </tr>
                }
            }
    </table>

    </div>