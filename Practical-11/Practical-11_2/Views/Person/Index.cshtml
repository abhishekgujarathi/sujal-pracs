@model List<Practical_11_2.Models.Person>

<h2>Person List</h2>

<button class="btn btn-primary" onclick="loadCreate()">Create</button>

<div id="partialContainer"></div>
<hr />
<br />
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>DOB</th>
            <th>Address</th>
            <th>Action</th>
        </tr>
    </thead>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@(item.DOB?.ToString("dd-MM-yyyy"))</td>
            <td>@item.Address</td>
            <td>
                <button onclick="loadUpdate(@item.Id)" class="btn btn-info">Edit</button>
                <button onclick="loadDelete(@item.Id)" class="btn btn-danger">Delete</button>
            </td>
        </tr>
    }
</table>
@section Scripts{
    <script>
        function loadCreate() {
            $("#partialContainer").load("/Person/Create", function () {
                $.validator.unobtrusive.parse("#partialContainer");
            });
        }

        function loadUpdate(id) {
            $("#partialContainer").load("/Person/Update/" + id, function () {
                $.validator.unobtrusive.parse("#partialContainer");
            });
        }

        function loadDelete(id) {
            $("#partialContainer").load("/Person/Delete/" + id);
        }
    </script>
}