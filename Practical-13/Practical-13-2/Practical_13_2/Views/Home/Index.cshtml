@model List<Practical_13_2.Models.EmployeeCountByDesignationViewModel>

@{
    ViewBag.Title = "Home";
}

<h2>Dashboard</h2>

<div class="d-flex gap-3 mt-4">
    @Html.ActionLink(
        "Employee Management",
        "Index",
        "Employee",
        null,
        new { @class = "btn btn-primary" }
    )

    @Html.ActionLink(
        "Designation Management",
        "Index",
        "Designation",
        null,
        new { @class = "btn btn-success" }
    )
</div>

<hr />

<div class="mt-3">
    @Html.ActionLink(
        "Show Employee Count by Designation",
        "GetEmployeeCountByDesignation",
        "Home",
        null,
        new { @class = "btn btn-warning" }
    )
</div>

<hr />

@if (Model != null && Model.Any())
{
    <h4>Employee Count by Designation</h4>

    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Designation</th>
                <th>Employee Count</th>
            </tr>
        </thead>
        <tbody>
            @{
                int count = 1;
            }

            @foreach (var item in Model)
            {
                <tr>
                    <td>@count</td>
                    <td>@item.DesignationName</td>
                    <td>@item.EmployeeCount</td>
                </tr>

                count++;
            }
        </tbody>
    </table>
}
else
{
    <p class="mt-3">Click the button to load employee count by designation.</p>
}