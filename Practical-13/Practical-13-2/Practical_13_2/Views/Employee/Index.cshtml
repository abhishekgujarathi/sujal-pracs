@model IEnumerable<Practical_13_2.Models.EmployeeViewModel>

@{
    ViewBag.Title = "Employee List";
}

<h2>Employee List</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">
        @TempData["Message"]
    </div>
}
<p>
    <a href="@Url.Action("Create", "Employee")" class="btn btn-primary">
        Create New Employee
    </a>
</p>

<p>
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
        Back To Dashboard
    </a>
</p>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>First Name</th>
            <th>Middle Name</th>
            <th>Last Name</th>
            <th>Mobile</th>
            <th>DOB</th>
            <th>Address</th>
            <th>Salary</th>
            <th>Designation</th>
            <th style="width:180px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            int count = 1;

            foreach (var item in Model)
            {
                <tr>
                    <td>@count</td>
                    <td>@item.FirstName</td>
                    <td>@item.MiddleName</td>
                    <td>@item.LastName</td>
                    <td>@item.MobileNumber</td>
                    <td>@item.DOB.ToString("dd-MM-yyyy")</td>
                    <td>@item.Address</td>
                    <td>@item.Salary.ToString("C")</td>
                    <td>@item.DesignationName</td>

                    <td>
                        <a href="@Url.Action("Update", "Employee", new { id = item.Id })" class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a href="@Url.Action("Delete", "Employee", new { id = item.Id })" class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </td>
                </tr>

                count++;
            }
        }
        else
        {
            <tr>
                <td colspan="10" class="text-center text-danger">
                    No Employees Found
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

