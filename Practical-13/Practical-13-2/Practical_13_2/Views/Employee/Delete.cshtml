@model Practical_13_2.Models.Employee

@{
    ViewBag.Title = "Delete Employee";
}

<h2>Delete Employee</h2>

<h4 class="text-danger">Are you sure you want to delete this?</h4>

<div class="border p-3">
    <dl class="row">
        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.FirstName</dd>

        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.LastName</dd>

        <dt class="col-sm-3">Mobile</dt>
        <dd class="col-sm-9">@Model.MobileNumber</dd>

        <dt class="col-sm-3">Salary</dt>
        <dd class="col-sm-9">@Model.Salary</dd>
    </dl>
</div>

@using (Html.BeginForm("DeleteConfirmed", "Employee"))
{
    @Html.HiddenFor(m => m.Id)

    <input type="submit" value="Delete" class="btn btn-danger" />
    @Html.ActionLink("Cancel", "Index", "Employee", null, new { @class = "btn btn-secondary" })
}