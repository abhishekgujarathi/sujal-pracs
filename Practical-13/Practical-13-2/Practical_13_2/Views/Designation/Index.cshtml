@model IEnumerable<Practical_13_2.Models.Designation>

@{
    ViewBag.Title = "Designation List";
}

<h2>Designation List</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">
        @TempData["Message"]
    </div>
}
<p>
    <a href="@Url.Action("Create", "Designation")" class="btn btn-primary">
        Create New Designation
    </a>
</p>

<p>
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
        Back To Dashboard
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Designation Name</th>
            <th style="width:150px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            int count = 1;

            foreach (var item in Model)
            {
                <tr>
                    <td>@count</td>
                    <td>@item.DesignationName</td>

                    <td>
                        <a href="@Url.Action("Update", "Designation", new { id = item.Id })"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a href="@Url.Action("Delete", "Designation", new { id = item.Id })"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </td>
                </tr>

                count++;
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center text-danger">
                    No Designations Found
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

