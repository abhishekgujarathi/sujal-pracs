@model Practical_13_2.Models.Designation

@{
    ViewBag.Title = "Delete Designation";
}

<h2>Delete Designation</h2>

<h4 class="text-danger">Are you sure you want to delete this?</h4>

<div class="border p-3">
    <dl class="row">
        <dt class="col-sm-3">Designation</dt>
        <dd class="col-sm-9">@Model.DesignationName</dd>
    </dl>
</div>

@using (Html.BeginForm("Delete", "Designation"))
{
    @Html.HiddenFor(m => m.Id)

    <input type="submit" value="Delete" class="btn btn-danger" />
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
}