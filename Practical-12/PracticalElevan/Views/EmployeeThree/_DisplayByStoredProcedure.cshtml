@model List<PracticalTwelve.Models.EmployeeDetailsViewModel>

<h3>Display By Stored Procedure</h3>

<table border="1" class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>FirstName</th>
            <th>MiddleName</th>
            <th>LastName</th>
            <th>Designation</th>
            <th>DOB</th>
            <th>MobileNumber</th>
            <th>Address</th>
            <th>Salary</th>
        </tr></thead>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-danger">No data found</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FirstName</td>
                    <td>@item.MiddleName</td>
                    <td>@item.LastName</td>
                    <td>@item.DesignationName</td>
                    <td>@item.DOB</td>
                    <td>@item.MobileNumber</td>
                    <td>@item.Address</td>
                    <td>@item.Salary</td>
                </tr>
            }
        }
</table>
<hr>
