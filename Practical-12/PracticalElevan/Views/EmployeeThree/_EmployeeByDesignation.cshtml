@model List<PracticalTwelve.Models.EmployeeDetailsByDesignationViewModel>
<br>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>First Name</th>
            <th>Middle Name</th>
            <th>Last Name</th>
            <th>DOB</th>
            <th>Mobile</th>
            <th>Address</th>
            <th>Salary</th>
        </tr>
        </thead>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="8">No data found</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FirstName</td>
                    <td>@item.MiddleName</td>
                    <td>@item.LastName</td>
                    <td>@item.DOB</td>
                    <td>@item.MobileNumber</td>
                    <td>@item.Address</td>
                    <td>@item.Salary</td>
                </tr>
            }
        }
</table>